<?xml version="1.0" encoding="utf-8"?>
<!-- Text uses the system notification text styles, so it stays readable on light and dark notification backgrounds.
     When the user picks a solid colour, AdhanService sets black or white text for that colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_launcher_bg_art"
        android:scaleType="centerInside" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">
        <TextView
            android:id="@+id/pn_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/pn_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold"
            android:textSize="22sp" />
    </LinearLayout>
    <Chronometer
        android:id="@+id/pn_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textStyle="bold"
        android:textSize="30sp" />
</LinearLayout>
