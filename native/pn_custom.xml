<?xml version="1.0" encoding="utf-8"?>
<!-- Approved compact style: dark card, app icon, prayer name in a green frame, large countdown in a gold frame.
     Kept inside the 64dp collapsed notification height. Same layout is used when expanded. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pn_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/pn_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_launcher_bg_art"
        android:scaleType="centerInside" />
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/pn_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/pn_frame_name"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="19sp"
            android:autoSizeStepGranularity="1sp"
            android:textSize="19sp" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layoutDirection="ltr"
        android:background="@drawable/pn_frame_time"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="3dp">
        <Chronometer
            android:id="@+id/pn_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#F0CF7F"
            android:textStyle="bold"
            android:textSize="28sp" />
        <TextView
            android:id="@+id/pn_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="متبقي"
            android:textColor="#B7A06A"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
